import { Suspense, useEffect, useRef } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import {
  ContactShadows,
  Html,
  OrbitControls,
  useAnimations,
  useGLTF,
} from '@react-three/drei';
import * as THREE from 'three';

function DeskModel() {
  const { scene } = useGLTF('/models/ibms-desk.glb');

  return (
    <group position={[0.65, -0.58, -0.35]} scale={0.82}>
      <primitive object={scene} />
    </group>
  );
}

function RobotModel() {
  const robotRef = useRef<THREE.Group>(null);
  const { scene, animations } = useGLTF('/models/ibms-robot.glb');
  const { actions } = useAnimations(animations, robotRef);

  useEffect(() => {
    const action = actions['Sitting'] ?? actions['Idle'];

    if (!action) return;

    action.reset().fadeIn(0.6).play();
    action.setLoop(THREE.LoopRepeat, Infinity);

    return () => {
      action.fadeOut(0.3);
    };
  }, [actions]);

  useFrame((state) => {
    if (!robotRef.current) return;

    // Mouvement discret du buste, sans faire flotter tout le robot.
    robotRef.current.rotation.y =
      Math.PI / 2 +
      Math.sin(state.clock.elapsedTime * 0.35) * 0.012;
  });

  return (
    <group
      ref={robotRef}
      position={[-0.48, 0.05, -0.15]}
      scale={0.36}
    >
      <primitive object={scene} />
    </group>
  );
}

function CodeOnScreen() {
  return (
    <Html
      transform
      position={[0.56, 0.2, 0.105]}
      rotation={[0, 0, 0]}
      distanceFactor={1.7}
      style={{
        width: '260px',
        pointerEvents: 'none',
        userSelect: 'none',
      }}
    >
      <div className="overflow-hidden rounded-md border border-sky-300/40 bg-[#0B1830] font-mono text-[10px] leading-[1.7] text-slate-100 shadow-[0_0_22px_rgba(56,189,248,0.2)]">
        <div className="flex items-center gap-1.5 border-b border-white/10 bg-[#14243D] px-3 py-2 text-[9px] text-slate-300">
          <span className="h-2 w-2 rounded-full bg-rose-400" />
          <span className="h-2 w-2 rounded-full bg-amber-300" />
          <span className="h-2 w-2 rounded-full bg-emerald-400" />
          <span className="ml-2">ibms_ai.py</span>
          <span className="ml-auto text-sky-300">Python</span>
        </div>

        <div className="space-y-0 px-3 py-2">
          <div><span className="text-fuchsia-300">class</span> <span className="text-amber-200">IBMSAI</span>:</div>
          <div className="pl-3"><span className="text-fuchsia-300">def</span> <span className="text-sky-300">build</span>(self):</div>
          <div className="pl-6">project = <span className="text-emerald-300">"Senegal"</span></div>
          <div className="pl-6">innovation = <span className="text-orange-200">True</span></div>
          <div className="pl-6"><span className="text-fuchsia-300">return</span> project</div>
          <div className="mt-2 border-t border-white/10 pt-2 text-emerald-300">
            {'>'} Building the future_
          </div>
        </div>
      </div>
    </Html>
  );
}

function SceneContent() {
  return (
    <>
      <color attach="background" args={['#F4F8FC']} />

      <ambientLight intensity={1.7} />

      <directionalLight
        position={[3, 5, 4]}
        intensity={2.5}
        color="#FFFFFF"
      />

      <pointLight
        position={[-2, 2, 2]}
        intensity={8}
        color="#73DDF5"
      />

      <pointLight
        position={[2, 1.5, -1]}
        intensity={5}
        color="#A9C8FF"
      />

      <Suspense fallback={null}>
        <DeskModel />
        <RobotModel />
        <CodeOnScreen />

        <ContactShadows
          position={[0, -0.48, 0]}
          opacity={0.2}
          scale={4}
          blur={2.5}
          far={3}
        />
      </Suspense>
    </>
  );
}

function LoadingScene() {
  return (
    <Html center>
      <div className="whitespace-nowrap rounded-full border border-sky-200 bg-white/90 px-4 py-2 text-xs text-slate-600 shadow-sm">
        Chargement de l'espace 3D…
      </div>
    </Html>
  );
}

export function IBMSRobot() {
  const controlsRef = useRef<any>(null);

  return (
    <div className="relative h-[470px] w-full overflow-hidden rounded-2xl md:h-[560px]">
      <Canvas
        camera={{
          position: [0, 1.15, 4.6],
          fov: 38,
          near: 0.1,
          far: 100,
        }}
        dpr={[1, 1.5]}
        gl={{ antialias: true, alpha: false }}
        onCreated={({ gl }) => {
          gl.setClearColor('#F4F8FC', 1);
        }}
        fallback={
          <div className="p-6 text-sm text-slate-600">
            Cette scène nécessite un navigateur compatible WebGL.
          </div>
        }
      >
        <Suspense fallback={<LoadingScene />}>
          <SceneContent />
        </Suspense>

        <OrbitControls
          ref={controlsRef}
          makeDefault
          target={[0, 0.35, 0]}
          enablePan={false}
          enableRotate
          enableZoom
          minDistance={3}
          maxDistance={7}
          minPolarAngle={0.45}
          maxPolarAngle={Math.PI / 2.02}
          rotateSpeed={0.7}
          zoomSpeed={0.7}
          dampingFactor={0.08}
          enableDamping
        />
      </Canvas>

      <div className="pointer-events-none absolute bottom-3 left-3 right-3 flex items-center justify-between gap-2">
        <span className="rounded-full border border-slate-200/80 bg-white/85 px-3 py-1.5 text-[10px] font-medium tracking-wide text-slate-600 shadow-sm backdrop-blur">
          IBMS · AI WORKSPACE
        </span>

        <span className="rounded-full border border-sky-100 bg-white/90 px-3 py-1.5 text-[10px] text-slate-600 shadow-sm backdrop-blur">
          Glisser pour tourner · Molette pour zoomer
        </span>
      </div>
    </div>
  );
}

useGLTF.preload('/models/ibms-desk.glb');
useGLTF.preload('/models/ibms-robot.glb');
