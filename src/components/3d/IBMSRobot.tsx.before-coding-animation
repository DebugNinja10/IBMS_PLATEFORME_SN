import { Suspense, useEffect, useRef } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import {
  ContactShadows,
  Html,
  OrbitControls,
  useAnimations,
  useGLTF,
} from '@react-three/drei';
import * as THREE from 'three';

function DeskModel() {
  const { scene } = useGLTF('/models/ibms-desk.glb');

  return (
    <group position={[0.65, -0.58, -0.35]} scale={0.82}>
      <primitive object={scene} />
    </group>
  );
}

function RobotModel() {
  const robotRef = useRef<THREE.Group>(null);
  const { scene, animations } = useGLTF('/models/ibms-robot.glb');
  const { actions } = useAnimations(animations, robotRef);

  useEffect(() => {
    // "Sitting" est joué une seule fois pour éviter la répétition
    // du mouvement assis-debout.
    const action = actions['Sitting'];

    if (!action) {
      console.warn(
        'Animation Sitting indisponible. Animations disponibles :',
        Object.keys(actions),
      );
      return;
    }

    action.reset();
    action.setLoop(THREE.LoopOnce, 1);
    action.clampWhenFinished = true;
    action.fadeIn(0.5);
    action.play();

    return () => {
      action.stop();
    };
  }, [actions]);

  useFrame((state) => {
    if (!robotRef.current) return;

    // Mouvement très léger, sans faire tourner tout le personnage.
    robotRef.current.rotation.y =
      Math.PI / 2 + Math.sin(state.clock.elapsedTime * 0.3) * 0.008;
  });

  return (
    <group
      ref={robotRef}
      position={[-0.48, 0.05, -0.15]}
      scale={0.36}
    >
      <primitive object={scene} />
    </group>
  );
}

